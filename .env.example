# Copy this file to .env.local, or add keys from the API keys popup in the app.
# All keys are free. Imbalance works without them, but each one unlocks more.

# CSFloat: individual listings with exact floats (needed to find low-float skins).
CSFLOAT_API_KEY=

# AI advisor (optional, any one is enough).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
